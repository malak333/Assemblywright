{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "outcome", "acceptance_criteria", "obligations"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "outcome": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirement"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "requirement": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
    }
  }
}
